# Copy these settings into server/.env and fill in your own values.
PGHOST=localhost
PGPORT=5432
PGDATABASE=wifi_attendance
PGUSER=postgres
PGPASSWORD=your-database-password

# Use your own password with at least 8 characters. No default login is enabled.
ADMIN_PASSWORD=replace-with-your-own-password

PORT=3000
# Keep false for local HTTP. Set true only when using HTTPS.
COOKIE_SECURE=false
